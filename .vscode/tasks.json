{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build active C file",
            "type": "process",
            "command": "C:/Users/Wesley/Downloads/w64devkit/bin/gcc.exe",
            "args": [
                "-std=c11",
                "-Wall",
                "-Wextra",
                "${workspaceFolder}/main.c",
                "${workspaceFolder}/mapa.c",
                "${workspaceFolder}/jogador.c",
                "${workspaceFolder}/eventos.c",
                "-o",
                "${workspaceFolder}/output/main.exe",
                "-I",
                "${workspaceFolder}/raylib/src",
                "-L",
                "${workspaceFolder}/raylib/src",
                "-lraylib",
                "-lopengl32",
                "-lgdi32",
                "-lwinmm"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}
